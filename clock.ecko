# clock - a monotonic millisecond clock (the std.time bridge for perf).
#
# Kept in its own file so main.ecko can export a function named `time` without
# colliding with the `time` binding that `import std.time` introduces.
#
# Read in nanoseconds and returned as fractional milliseconds, so a call that
# takes microseconds measures as what it took rather than as 0 or 1.
# `time.monotonic_ns()` is Ecko 0.58 and later.
import std.time

## ms() -> the steady clock's reading in milliseconds, as a Float.
export fn ms() {
    float(time.monotonic_ns()) / 1000000.0
}
